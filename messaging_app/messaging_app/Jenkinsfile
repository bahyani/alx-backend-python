pipeline {
    agent any
    
    environment {
        // Project configuration
        PROJECT_NAME = 'Django Messaging App'
        PYTHON_VERSION = '3.9'
        
        // GitHub credentials (configured in Jenkins)
        // For public repositories, you can skip credentials or use dummy ones
        // For private repositories, you need a real GitHub Personal Access Token
        GITHUB_CREDENTIALS = credentials('github-credentials')
        
        // Test report paths
        TEST_REPORT_DIR = 'test-reports'
        COVERAGE_REPORT_DIR = 'coverage-reports'
    }
    
    options {
        // Keep only the last 10 builds
        buildDiscarder(logRotator(numToKeepStr: '10'))
        
        // Add timestamps to console output
        timestamps()
        
        // Timeout after 30 minutes
        timeout(time: 30, unit: 'MINUTES')
        
        // Skip checking out code by default
        skipDefaultCheckout(true)
    }
    
    triggers {
        // Poll SCM every 5 minutes for changes (optional)
        pollSCM('H/5 * * * *')
    }
    
    stages {
        stage('Checkout') {
            steps {
                script {
                    echo "========================================="
                    echo "Stage 1: Checking out source code"
                    echo "========================================="
                }
                
                // Checkout code from GitHub - bahyani/alx-backend-python
                checkout([
                    $class: 'GitSCM',
                    branches: [[name: '*/main']],
                    userRemoteConfigs: [[
                        url: 'https://github.com/bahyani/alx-backend-python.git',
                        credentialsId: ''
                    ]]
                ])
                
                script {
                    echo "✅ Source code checked out successfully"
                    echo "Repository: github.com/bahyani/alx-backend-python"
                    echo "Current directory: ${pwd()}"
                    
                    // List files in the directory
                    sh 'ls -la'
                }
            }
        }
        
        stage('Setup Python Environment') {
            steps {
                script {
                    echo "========================================="
                    echo "Stage 2: Setting up Python environment"
                    echo "========================================="
                }
                
                // Create virtual environment using ShiningPanda plugin
                sh """
                    python3 --version
                    python3 -m venv venv
                    . venv/bin/activate
                    python --version
                    pip install --upgrade pip
                """
                
                script {
                    echo "✅ Python virtual environment created"
                }
            }
        }
        
        stage('Install Dependencies') {
            steps {
                script {
                    echo "========================================="
                    echo "Stage 3: Installing project dependencies"
                    echo "========================================="
                }
                
                dir('messaging_app') {
                    sh """
                        . ../venv/bin/activate
                        
                        # Install dependencies from requirements.txt
                        if [ -f requirements.txt ]; then
                            echo "Installing from requirements.txt..."
                            pip install -r requirements.txt
                        else
                            echo "Warning: requirements.txt not found!"
                        fi
                        
                        # Install testing dependencies
                        echo "Installing testing dependencies..."
                        pip install pytest pytest-django pytest-cov pytest-html
                        pip install flake8 coverage
                        
                        # List installed packages
                        echo "Installed packages:"
                        pip list
                    """
                }
                
                script {
                    echo "✅ Dependencies installed successfully"
                }
            }
        }
        
        stage('Run Linting') {
            steps {
                script {
                    echo "========================================="
                    echo "Stage 4: Running code quality checks"
                    echo "========================================="
                }
                
                dir('messaging_app') {
                    sh """
                        . ../venv/bin/activate
                        
                        echo "Running flake8 linting..."
                        flake8 . --max-line-length=120 --exclude=venv,migrations,__pycache__,*.pyc --count --statistics || true
                    """
                }
                
                script {
                    echo "✅ Linting completed"
                }
            }
        }
        
        stage('Run Tests') {
            steps {
                script {
                    echo "========================================="
                    echo "Stage 5: Running pytest tests"
                    echo "========================================="
                }
                
                dir('messaging_app') {
                    sh """
                        . ../venv/bin/activate
                        
                        # Create test report directory
                        mkdir -p ../${TEST_REPORT_DIR}
                        mkdir -p ../${COVERAGE_REPORT_DIR}
                        
                        # Set Django settings module
                        export DJANGO_SETTINGS_MODULE=messaging_app.settings
                        
                        # Run pytest with coverage and HTML report
                        pytest \\
                            --verbose \\
                            --junit-xml=../${TEST_REPORT_DIR}/junit.xml \\
                            --html=../${TEST_REPORT_DIR}/report.html \\
                            --self-contained-html \\
                            --cov=. \\
                            --cov-report=html:../${COVERAGE_REPORT_DIR} \\
                            --cov-report=xml:../${COVERAGE_REPORT_DIR}/coverage.xml \\
                            --cov-report=term-missing \\
                            || true
                        
                        echo "Test execution completed"
                    """
                }
                
                script {
                    echo "✅ Tests executed successfully"
                }
            }
        }
        
        stage('Generate Test Reports') {
            steps {
                script {
                    echo "========================================="
                    echo "Stage 6: Generating test reports"
                    echo "========================================="
                }
                
                // Publish JUnit test results
                junit allowEmptyResults: true, testResults: "${TEST_REPORT_DIR}/junit.xml"
                
                // Publish HTML test report
                publishHTML([
                    allowMissing: false,
                    alwaysLinkToLastBuild: true,
                    keepAll: true,
                    reportDir: "${TEST_REPORT_DIR}",
                    reportFiles: 'report.html',
                    reportName: 'Pytest HTML Report',
                    reportTitles: 'Test Execution Report'
                ])
                
                // Publish HTML coverage report
                publishHTML([
                    allowMissing: false,
                    alwaysLinkToLastBuild: true,
                    keepAll: true,
                    reportDir: "${COVERAGE_REPORT_DIR}",
                    reportFiles: 'index.html',
                    reportName: 'Coverage Report',
                    reportTitles: 'Code Coverage Report'
                ])
                
                script {
                    echo "✅ Test reports generated and published"
                }
            }
        }
        
        stage('Archive Artifacts') {
            steps {
                script {
                    echo "========================================="
                    echo "Stage 7: Archiving build artifacts"
                    echo "========================================="
                }
                
                // Archive test reports and coverage data
                archiveArtifacts artifacts: "${TEST_REPORT_DIR}/**/*", fingerprint: true, allowEmptyArchive: true
                archiveArtifacts artifacts: "${COVERAGE_REPORT_DIR}/**/*", fingerprint: true, allowEmptyArchive: true
                
                script {
                    echo "✅ Artifacts archived successfully"
                }
            }
        }
    }
    
    post {
        always {
            script {
                echo "========================================="
                echo "Pipeline execution completed"
                echo "========================================="
            }
            
            // Clean up workspace
            cleanWs deleteDirs: true, notFailBuild: true
        }
        
        success {
            script {
                echo "✅ Pipeline Status: SUCCESS"
                echo "Build #${env.BUILD_NUMBER} completed successfully!"
            }
        }
        
        failure {
            script {
                echo "❌ Pipeline Status: FAILED"
                echo "Build #${env.BUILD_NUMBER} failed. Please check the logs."
            }
        }
        
        unstable {
            script {
                echo "⚠️  Pipeline Status: UNSTABLE"
                echo "Build #${env.BUILD_NUMBER} has test failures."
            }
        }
    }
}
        
        stage('Setup Python Environment') {
            steps {
                script {
                    echo "========================================="
                    echo "Stage 2: Setting up Python environment"
                    echo "========================================="
                }
                
                // Create virtual environment using ShiningPanda plugin
                sh """
                    python3 --version
                    python3 -m venv venv
                    . venv/bin/activate
                    python --version
                    pip install --upgrade pip
                """
                
                script {
                    echo "✅ Python virtual environment created"
                }
            }
        }
        
        stage('Install Dependencies') {
            steps {
                script {
                    echo "========================================="
                    echo "Stage 3: Installing project dependencies"
                    echo "========================================="
                }
                
                dir('messaging_app') {
                    sh """
                        . ../venv/bin/activate
                        
                        # Install dependencies from requirements.txt
                        if [ -f requirements.txt ]; then
                            echo "Installing from requirements.txt..."
                            pip install -r requirements.txt
                        else
                            echo "Warning: requirements.txt not found!"
                        fi
                        
                        # Install testing dependencies
                        echo "Installing testing dependencies..."
                        pip install pytest pytest-django pytest-cov pytest-html
                        pip install flake8 coverage
                        
                        # List installed packages
                        echo "Installed packages:"
                        pip list
                    """
                }
                
                script {
                    echo "✅ Dependencies installed successfully"
                }
            }
        }
        
        stage('Run Linting') {
            steps {
                script {
                    echo "========================================="
                    echo "Stage 4: Running code quality checks"
                    echo "========================================="
                }
                
                dir('messaging_app') {
                    sh """
                        . ../venv/bin/activate
                        
                        echo "Running flake8 linting..."
                        flake8 . --max-line-length=120 --exclude=venv,migrations,__pycache__,*.pyc --count --statistics || true
                    """
                }
                
                script {
                    echo "✅ Linting completed"
                }
            }
        }
        
        stage('Run Tests') {
            steps {
                script {
                    echo "========================================="
                    echo "Stage 5: Running pytest tests"
                    echo "========================================="
                }
                
                dir('messaging_app') {
                    sh """
                        . ../venv/bin/activate
                        
                        # Create test report directory
                        mkdir -p ../${TEST_REPORT_DIR}
                        mkdir -p ../${COVERAGE_REPORT_DIR}
                        
                        # Set Django settings module
                        export DJANGO_SETTINGS_MODULE=messaging_app.settings
                        
                        # Run pytest with coverage and HTML report
                        pytest \\
                            --verbose \\
                            --junit-xml=../${TEST_REPORT_DIR}/junit.xml \\
                            --html=../${TEST_REPORT_DIR}/report.html \\
                            --self-contained-html \\
                            --cov=. \\
                            --cov-report=html:../${COVERAGE_REPORT_DIR} \\
                            --cov-report=xml:../${COVERAGE_REPORT_DIR}/coverage.xml \\
                            --cov-report=term-missing \\
                            || true
                        
                        echo "Test execution completed"
                    """
                }
                
                script {
                    echo "✅ Tests executed successfully"
                }
            }
        }
        
        stage('Generate Test Reports') {
            steps {
                script {
                    echo "========================================="
                    echo "Stage 6: Generating test reports"
                    echo "========================================="
                }
                
                // Publish JUnit test results
                junit allowEmptyResults: true, testResults: "${TEST_REPORT_DIR}/junit.xml"
                
                // Publish HTML test report
                publishHTML([
                    allowMissing: false,
                    alwaysLinkToLastBuild: true,
                    keepAll: true,
                    reportDir: "${TEST_REPORT_DIR}",
                    reportFiles: 'report.html',
                    reportName: 'Pytest HTML Report',
                    reportTitles: 'Test Execution Report'
                ])
                
                // Publish HTML coverage report
                publishHTML([
                    allowMissing: false,
                    alwaysLinkToLastBuild: true,
                    keepAll: true,
                    reportDir: "${COVERAGE_REPORT_DIR}",
                    reportFiles: 'index.html',
                    reportName: 'Coverage Report',
                    reportTitles: 'Code Coverage Report'
                ])
                
                script {
                    echo "✅ Test reports generated and published"
                }
            }
        }
        
        stage('Archive Artifacts') {
            steps {
                script {
                    echo "========================================="
                    echo "Stage 7: Archiving build artifacts"
                    echo "========================================="
                }
                
                // Archive test reports and coverage data
                archiveArtifacts artifacts: "${TEST_REPORT_DIR}/**/*", fingerprint: true, allowEmptyArchive: true
                archiveArtifacts artifacts: "${COVERAGE_REPORT_DIR}/**/*", fingerprint: true, allowEmptyArchive: true
                
                script {
                    echo "✅ Artifacts archived successfully"
                }
            }
        }
    }
    
    post {
        always {
            script {
                echo "========================================="
                echo "Pipeline execution completed"
                echo "========================================="
            }
            
            // Clean up workspace
            cleanWs deleteDirs: true, notFailBuild: true
        }
        
        success {
            script {
                echo "✅ Pipeline Status: SUCCESS"
                echo "Build #${env.BUILD_NUMBER} completed successfully!"
            }
        }
        
        failure {
            script {
                echo "❌ Pipeline Status: FAILED"
                echo "Build #${env.BUILD_NUMBER} failed. Please check the logs."
            }
        }
        
        unstable {
            script {
                echo "⚠️  Pipeline Status: UNSTABLE"
                echo "Build #${env.BUILD_NUMBER} has test failures."
            }
        }
    }
}
